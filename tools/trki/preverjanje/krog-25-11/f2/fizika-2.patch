+        for (; k < 6 / DT && !rb.cars.some(c => c.hitCar > 0 || c.hitWall > 0); k++) { for (const [K, r] of [[B, ra], [C, rb]]) { Math.random = seeded(1000 + k); K.aiControl(r.player, r, DT); r.step(DT); }
