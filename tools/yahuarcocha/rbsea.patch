+    const S = SEA, y = S.lv, x0 = S.x0, z0 = S.z0, x1 = S.x0 + (S.nx - 1) * S.c, z1 = S.z0 + (S.nz - 1) * S.c, gw = new GB(true), wc = [1, 1, 1], uv = (x, z) => [x / 16, -z / 16];
+    for (let bz = z0; bz < z1; bz += 64) for (let bx = x0; bx < x1; bx += 64) {
